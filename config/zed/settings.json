// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_buffer_font_family": "FiraCode Nerd Font",
  "use_display_p3": true,
  "accessible_mode": true,
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "mode": "yolo",
        "thinking_level": "xhigh",
        "model": "gemini-4-carbon"
      },
      "type": "registry"
    },
    "opencode-v2": {
      "default_config_options": {
        "mode": "build",
        "effort": "medium",
        "model": "cpa/glm-5.3-flash"
      },
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "play_sound_when_agent_done": "when_hidden",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow"
        }
      }
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-6.1-sol"
    }
  },
  "vim_mode": true,
  "buffer_font_size": 14,
  "buffer_font_family": "Fira Code",

  "languages": {
    "Nix": {
      "language_servers": ["nil", "!nixd"]
    }
  },

  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "GitHub Light"
  },
  "theme_overrides": {
    "GitHub Light": {
      "vim.normal.background": "#00000000",
      "vim.insert.background": "#00000000",
      "vim.replace.background": "#00000000",
      "vim.visual.background": "#00000000",
      "vim.visual_line.background": "#00000000",
      "vim.visual_block.background": "#00000000"
    }
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  }
}
